# =============================================================================
# KAIROS LABS — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha com suas credenciais reais.
# NUNCA commite o .env.local — ele já está no .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — Cliente público (exposto ao browser)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------

# URL do projeto Supabase. Segura para expor ao client-side.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave anônima do Supabase. Segura para expor ao client-side.
# O acesso aos dados é controlado pelas políticas de RLS (Row Level Security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# SUPABASE — Service Role (NUNCA expor ao client-side)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------

# Chave de service role. Bypassa o RLS — use apenas em Server Actions e
# Server Components. Jamais inclua em código que roda no browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
