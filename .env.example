# =============================================================================
# KAIROS LABS — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha com suas credenciais reais.
# NUNCA commite o .env.local — ele já está no .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — Cliente público (exposto ao browser)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------

# URL do projeto Supabase. Segura para expor ao client-side.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave anônima do Supabase. Segura para expor ao client-side.
# O acesso aos dados é controlado pelas políticas de RLS (Row Level Security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# SUPABASE — Service Role (NUNCA expor ao client-side)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------

# Chave de service role. Bypassa o RLS — use apenas em Server Actions e
# Server Components. Jamais inclua em código que roda no browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# SONARCLOUD — CLI de qualidade (opcional para desenvolvimento local)
# Necessário apenas para rodar ./scripts/sonar-check.sh localmente.
# Em CI, o token é injetado via secret SONAR_TOKEN (já configurado no repo).
# -----------------------------------------------------------------------------

# Token de acesso pessoal ao SonarCloud.
# Como gerar:
#   1. Acesse https://sonarcloud.io e faça login (pode usar sua conta GitHub)
#   2. Clique no avatar (canto superior direito) → My Account → Security
#   3. Em "Generate Tokens", dê um nome (ex: "kairos-labs-local") e clique em Generate
#   4. Copie o token gerado — ele só é exibido uma vez
#   5. Cole aqui (sem aspas)
SONAR_TOKEN=

# Chave de identificação do projeto no SonarCloud.
# Identifica univocamente este repositório na plataforma — não altere este valor.
# Formato: <organização>_<nome-do-repositório>
# Onde encontrar: sonarcloud.io → projeto "kairos-labs" → Information (coluna lateral)
SONAR_PROJECT_KEY=CabPiz_kairos-labs
